# Vorlage für .env.local (diese Datei hier enthält KEINE echten Werte und darf ins Git).
# 1. Kopiere diese Datei zu ".env.local"
# 2. Trage die Werte aus Supabase ein: Project Settings -> API Keys
# Nur den "publishable" Key verwenden – NIEMALS den "secret"/"service_role" Key!
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Registrierungsformular anzeigen? Standard: false (nur Login).
# Achtung: Das blendet nur das Formular ein/aus. Den echten Schutz stellst du im
# Supabase-Dashboard ein: Authentication -> Sign In / Providers -> "Allow new users to sign up".
VITE_ENABLE_SIGNUP=false
